# Application
APP_NAME=Certificate Printing Management System
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database - SQLite for development (default)
DATABASE_URL=sqlite:///./certificate_system.db

# PostgreSQL example (uncomment and configure for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/certificate_db

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://lucenttech.in,https://www.lucenttech.in

# File storage (relative to backend/ or absolute paths)
UPLOAD_DIR=uploads
GENERATED_DIR=generated/certificates
MAX_UPLOAD_SIZE_MB=10

# Default admin (created / migrated on startup)
DEFAULT_ADMIN_USERNAME=Lucenttechnology01@gmail.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULL_NAME=System Administrator

# Email OTP login — only this address can sign in
LOGIN_EMAIL=Lucenttechnology01@gmail.com
OTP_EXPIRE_MINUTES=10

# Gmail SMTP (use an App Password, not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Lucenttechnology01@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Lucenttechnology01@gmail.com
SMTP_USE_TLS=true
